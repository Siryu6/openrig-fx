    a openrig:Role ;
    rdfs:label "decayHigh" ;
    rdfs:comment "Decay time of the high band, s, or a multiplier of the mid decay when unitless." .

openrig:crossoverLow
    a openrig:Role ;
    rdfs:label "crossoverLow" ;
    rdfs:comment "Frequency between the low and mid decay bands, Hz." .

openrig:crossoverHigh
    a openrig:Role ;
    rdfs:label "crossoverHigh" ;
    rdfs:comment "Frequency between the mid and high decay bands, Hz." .

openrig:size
    a openrig:Role ;
    rdfs:label "size" ;
    rdfs:comment "Room size, unitless or m." .

openrig:damping
    a openrig:Role ;
    rdfs:label "damping" ;
    rdfs:comment "High frequency damping of the tail." .

openrig:pitchShift
    a openrig:Role ;
    rdfs:label "pitchShift" ;
    rdfs:comment "Pitch shift, semitones (or cents per the unit)." .

openrig:detectedNote
    a openrig:Role ;
    rdfs:label "detectedNote" ;
    rdfs:comment "Meter: detected input note, MIDI note number (0 when none)." .

openrig:detectedCents
    a openrig:Role ;
    rdfs:label "detectedCents" ;
    rdfs:comment "Meter: deviation of the detected note, cents." .

openrig:trackingQuality
    a openrig:Role ;
    rdfs:label "trackingQuality" ;
    rdfs:comment "Meter: confidence of the pitch tracking, 0 to 1." .

openrig:pedalPosition
    a openrig:Role ;
    rdfs:label "pedalPosition" ;
    rdfs:comment "Expression pedal position, minimum heel down to maximum toe down." .

openrig:sweepLow
    a openrig:Role ;
    rdfs:label "sweepLow" ;
    rdfs:comment "Filter frequency at the heel, Hz." .

openrig:sweepHigh
    a openrig:Role ;
    rdfs:label "sweepHigh" ;
    rdfs:comment "Filter frequency at the toe, Hz." .

openrig:resonance
    a openrig:Role ;
    rdfs:label "resonance" ;
    rdfs:comment "Filter resonance (Q)." .

openrig:Sine
    a openrig:Waveform ;
    rdfs:label "Sine" ;
    rdfs:comment "sin(2 pi phase)." .

openrig:Triangle
    a openrig:Waveform ;
    rdfs:label "Triangle" ;
    rdfs:comment "Triangle, 0 at phase 0, 1 at 1/4, -1 at 3/4." .

openrig:Square
    a openrig:Waveform ;
    rdfs:label "Square" ;
    rdfs:comment "1 for phase below 1/2, -1 above." .

