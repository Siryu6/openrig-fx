# Generated from orx_plugin::view by `cargo xtask vocab`: do not edit.
# Specification: docs/OPENRIG-VIEWS.md

<https://openrig.eu/ns/view#>
    a owl:Ontology ;
    rdfs:label "OpenRig native views" ;
    rdfs:comment "Metadata letting a host draw a native view of a plugin: the view, port roles, exact curves and data streams." ;
    owl:versionInfo "1" .

openrig:View
    a rdfs:Class ;
    rdfs:label "View" ;
    rdfs:comment "A kind of native view a host draws for a plugin. Instances are the views below." .

openrig:Role
    a rdfs:Class ;
    rdfs:label "Role" ;
    rdfs:comment "What a port means to the view. Instances are lower camel case individuals; each states its value convention." .

openrig:Waveform
    a rdfs:Class ;
    rdfs:label "Waveform" ;
    rdfs:comment "An LFO waveform with an exact definition, so the host draws the curve the plugin plays." .

openrig:FilterShape
    a rdfs:Class ;
    rdfs:label "FilterShape" ;
    rdfs:comment "A filter response with the RBJ Audio EQ Cookbook definition, for openrig:curve bands. openrig:Off is a band that contributes nothing." .

openrig:QUnit
    a rdfs:Class ;
    rdfs:label "QUnit" ;
    rdfs:comment "How the Q value of an openrig:curve band reads." .

openrig:DynamicsKind
    a rdfs:Class ;
    rdfs:label "DynamicsKind" ;
    rdfs:comment "The kind of processor a DynamicsView draws." .

openrig:Curve
    a rdfs:Class ;
    rdfs:label "Curve" ;
    rdfs:comment "One band of a frequency response the host computes from port values." .

openrig:ShapeChoice
    a rdfs:Class ;
    rdfs:label "ShapeChoice" ;
    rdfs:comment "One value of an openrig:shapePort and the band shape it selects." .

openrig:Stream
    a rdfs:Class ;
    rdfs:label "Stream" ;
    rdfs:comment "Description of the frames an atom output port sends." .

openrig:StreamContent
    a rdfs:Class ;
    rdfs:label "StreamContent" ;
    rdfs:comment "What the values of a stream frame are." .

openrig:Frame
    a rdfs:Class ;
    rdfs:label "Frame" ;
    rdfs:comment "Atom object sent on a stream port: openrig:channels (Int), openrig:position (Float) and openrig:values (Vector of Float, channel after channel)." .

openrig:Family
    a rdfs:Class ;
    rdfs:label "Family" ;
    rdfs:comment "How a host presents a plugin: in its own look, or as a faceplate of its own." .

openrig:KnobStyle
    a rdfs:Class ;
    rdfs:label "KnobStyle" ;
    rdfs:comment "The knob shape a faceplate draws." .

openrig:Finish
    a rdfs:Class ;
    rdfs:label "Finish" ;
    rdfs:comment "The surface of a faceplate." .

openrig:PlateStyle
    a rdfs:Class ;
    rdfs:label "PlateStyle" ;
    rdfs:comment "How the plate name of a faceplate is lettered." .

openrig:view
    a rdf:Property , owl:ObjectProperty ;
    rdfs:label "view" ;
    rdfs:domain lv2:Plugin ;
    rdfs:range openrig:View ;
    rdfs:comment "The view a host should draw above the plugin's controls." .

openrig:waveform
    a rdf:Property , owl:ObjectProperty ;
    rdfs:label "waveform" ;
    rdfs:domain lv2:Plugin ;
    rdfs:range openrig:Waveform ;
    rdfs:comment "Waveform of an LfoView; openrig:lfoShape morphs it where the waveform says so." .

openrig:dynamics
    a rdf:Property , owl:ObjectProperty ;
    rdfs:label "dynamics" ;
    rdfs:domain lv2:Plugin ;
    rdfs:range openrig:DynamicsKind ;
    rdfs:comment "Kind of processor of a DynamicsView." .

openrig:curve
    a rdf:Property , owl:ObjectProperty ;
    rdfs:label "curve" ;
    rdfs:domain lv2:Plugin ;
    rdfs:range openrig:Curve ;
    rdfs:comment "A band of the frequency response of an EqView; the response is the product of all bands." .

openrig:shape
    a rdf:Property , owl:ObjectProperty ;
    rdfs:label "shape" ;
    rdfs:domain openrig:Curve ;
    rdfs:range openrig:FilterShape ;
    rdfs:comment "Fixed shape of a band, or the shape an openrig:ShapeChoice selects." .

openrig:shapePort
    a rdf:Property , owl:DatatypeProperty ;
    rdfs:label "shapePort" ;
    rdfs:domain openrig:Curve ;
    rdfs:range xsd:string ;
    rdfs:comment "Symbol of the port choosing the band shape, with one openrig:shapeChoice per value." .

openrig:shapeChoice
    a rdf:Property , owl:ObjectProperty ;
    rdfs:label "shapeChoice" ;
    rdfs:domain openrig:Curve ;
    rdfs:range openrig:ShapeChoice ;
    rdfs:comment "Maps one rdf:value of the openrig:shapePort to an openrig:shape." .

openrig:frequency
    a rdf:Property , owl:DatatypeProperty ;
    rdfs:label "frequency" ;
    rdfs:domain openrig:Curve ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Fixed band frequency, Hz." .

openrig:frequencyPort
    a rdf:Property , owl:DatatypeProperty ;
    rdfs:label "frequencyPort" ;
    rdfs:domain openrig:Curve ;
    rdfs:range xsd:string ;
    rdfs:comment "Symbol of the port holding the band frequency, Hz." .

openrig:gain
    a rdf:Property , owl:DatatypeProperty ;
    rdfs:label "gain" ;
    rdfs:domain openrig:Curve ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Fixed band gain, dB." .

openrig:gainPort
    a rdf:Property , owl:DatatypeProperty ;
    rdfs:label "gainPort" ;
    rdfs:domain openrig:Curve ;
    rdfs:range xsd:string ;
    rdfs:comment "Symbol of the port holding the band gain, dB." .

openrig:q
    a rdf:Property , owl:DatatypeProperty ;
    rdfs:label "q" ;
    rdfs:domain openrig:Curve ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Fixed band Q, read per openrig:qUnit." .

openrig:qPort
    a rdf:Property , owl:DatatypeProperty ;
    rdfs:label "qPort" ;
    rdfs:domain openrig:Curve ;
    rdfs:range xsd:string ;
    rdfs:comment "Symbol of the port holding the band Q, read per openrig:qUnit." .

openrig:qUnit
    a rdf:Property , owl:ObjectProperty ;
    rdfs:label "qUnit" ;
    rdfs:domain openrig:Curve ;
    rdfs:range openrig:QUnit ;
    rdfs:comment "How the band Q reads." .

openrig:enablePort
    a rdf:Property , owl:DatatypeProperty ;
    rdfs:label "enablePort" ;
    rdfs:domain openrig:Curve ;
    rdfs:range xsd:string ;
    rdfs:comment "Symbol of a toggle port; the band is flat while it is 0." .

openrig:family
    a rdf:Property , owl:ObjectProperty ;
    rdfs:label "family" ;
    rdfs:domain lv2:Plugin ;
    rdfs:range openrig:Family ;
    rdfs:comment "The plugin's family; a host without faceplates draws every family alike." .

openrig:faceColor
    a rdf:Property , owl:DatatypeProperty ;
    rdfs:label "faceColor" ;
    rdfs:domain lv2:Plugin ;
    rdfs:range xsd:string ;
    rdfs:comment "Faceplate colour, \"#RRGGBB\" in sRGB. The host keeps its own accent, text and texture over it, and may darken or lighten it to keep labels readable." .

openrig:knobStyle
    a rdf:Property , owl:ObjectProperty ;
    rdfs:label "knobStyle" ;
    rdfs:domain lv2:Plugin ;
    rdfs:range openrig:KnobStyle ;
    rdfs:comment "The knob shape of the faceplate." .

openrig:finish
    a rdf:Property , owl:ObjectProperty ;
    rdfs:label "finish" ;
    rdfs:domain lv2:Plugin ;
    rdfs:range openrig:Finish ;
    rdfs:comment "The surface of the faceplate." .

openrig:wear
    a rdf:Property , owl:DatatypeProperty ;
    rdfs:label "wear" ;
    rdfs:domain lv2:Plugin ;
    rdfs:range xsd:decimal ;
    rdfs:comment "How worn the faceplate looks, 0 (new) to 1, fixed for the plugin. The host draws the wear from a seed it derives from the plugin URI, so a plugin always looks the same." .

openrig:plateName
    a rdf:Property , owl:DatatypeProperty ;
    rdfs:label "plateName" ;
    rdfs:domain lv2:Plugin ;
    rdfs:range xsd:string ;
    rdfs:comment "The short name printed on the faceplate, 12 characters at most." .

openrig:plateStyle
    a rdf:Property , owl:ObjectProperty ;
    rdfs:label "plateStyle" ;
    rdfs:domain lv2:Plugin ;
    rdfs:range openrig:PlateStyle ;
    rdfs:comment "The lettering of the plate name, openrig:Silkscreen when absent. Signature plugins only." .

openrig:tagline
    a rdf:Property , owl:DatatypeProperty ;
    rdfs:label "tagline" ;
    rdfs:domain lv2:Plugin ;
    rdfs:range xsd:string ;
    rdfs:comment "A few words under the plugin's name, 48 characters at most." .

openrig:order
    a rdf:Property , owl:DatatypeProperty ;
    rdfs:label "order" ;
    rdfs:domain lv2:Port ;
    rdfs:range xsd:positiveInteger ;
    rdfs:comment "Place (1 first) of the control on the faceplate, in reading order. Controls without one stay in the host's full control list." .

openrig:role
    a rdf:Property , owl:ObjectProperty ;
    rdfs:label "role" ;
    rdfs:domain lv2:Port ;
    rdfs:range openrig:Role ;
    rdfs:comment "What the port means to the view." .

openrig:primary
    a rdf:Property , owl:DatatypeProperty ;
    rdfs:label "primary" ;
    rdfs:domain lv2:Port ;
    rdfs:range xsd:positiveInteger ;
    rdfs:comment "Rank (1 first) of the port among the controls a compact host shows first, such as the knob strip of a footswitch screen." .

openrig:stream
    a rdf:Property , owl:ObjectProperty ;
    rdfs:label "stream" ;
    rdfs:domain lv2:Port ;
    rdfs:range openrig:Stream ;
    rdfs:comment "The frames this atom output sends." .

openrig:content
    a rdf:Property , owl:ObjectProperty ;
    rdfs:label "content" ;
    rdfs:domain openrig:Stream ;
    rdfs:range openrig:StreamContent ;
    rdfs:comment "What the values of each frame are." .

openrig:length
    a rdf:Property , owl:DatatypeProperty ;
    rdfs:label "length" ;
    rdfs:domain openrig:Stream ;
    rdfs:range xsd:positiveInteger ;
    rdfs:comment "Values per channel in each frame." .

openrig:channels
    a rdf:Property , owl:DatatypeProperty ;
    rdfs:label "channels" ;
    rdfs:domain openrig:Stream ;
    rdfs:range xsd:positiveInteger ;
    rdfs:comment "Channels in each frame. Also the key of the channel count in an openrig:Frame." .

openrig:rate
    a rdf:Property , owl:DatatypeProperty ;
    rdfs:label "rate" ;
    rdfs:domain openrig:Stream ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Most frames per second the plugin sends, Hz." .

openrig:position
    a rdf:Property , owl:DatatypeProperty ;
    rdfs:label "position" ;
    rdfs:domain openrig:Frame ;
    rdfs:range xsd:float ;
    rdfs:comment "A position in the frame (the current LFO phase of a ModulationCycle), per openrig:content." .

openrig:values
    a rdf:Property , owl:ObjectProperty ;
    rdfs:label "values" ;
    rdfs:domain openrig:Frame ;
    rdfs:range atom:Vector ;
    rdfs:comment "The values of the frame, channel after channel." .

openrig:EqView
    a openrig:View ;
    rdfs:label "EqView" ;
    rdfs:comment "Frequency response drawn from the plugin's openrig:curve descriptions." .

openrig:DynamicsView
    a openrig:View ;
    rdfs:label "DynamicsView" ;
    rdfs:comment "Static input/output level curve drawn from the threshold, ratio, knee and makeup roles, with the gain reduction meter." .

openrig:EchoTimelineView
    a openrig:View ;
    rdfs:label "EchoTimelineView" ;
    rdfs:comment "Echoes on a time axis drawn from the delay time, feedback and mix or wet level roles, over the host's tempo grid; the first echo can be dragged to set the delay time." .

openrig:DecayCurveView
    a openrig:View ;
    rdfs:label "DecayCurveView" ;
    rdfs:comment "Decay time against frequency drawn from the decay and crossover roles." .

openrig:LfoView
    a openrig:View ;
    rdfs:label "LfoView" ;
    rdfs:comment "One cycle of the modulation drawn from the LFO roles and openrig:waveform, or from a ModulationCycle stream." .

openrig:PitchView
    a openrig:View ;
    rdfs:label "PitchView" ;
    rdfs:comment "Pitch shift on a neck or keyboard drawn from the pitch roles and note meters." .

openrig:SweepView
    a openrig:View ;
    rdfs:label "SweepView" ;
    rdfs:comment "Filter response along its sweep drawn from the sweep roles." .

openrig:StepGridView
    a openrig:View ;
    rdfs:label "StepGridView" ;
    rdfs:comment "One bar in steps drawn from a StepGrid stream: the level each step lets through, the slice captured and its repeats, the playback speed and the playhead." .

openrig:mix
    a openrig:Role ;
    rdfs:label "mix" ;
    rdfs:comment "Wet share. 0 is dry only, the maximum of the range is wet only." .

openrig:wetLevel
    a openrig:Role ;
    rdfs:label "wetLevel" ;
    rdfs:comment "Level of the effect added to the dry signal, which stays at unity: 0 adds nothing; linear 0 to 1 (or 100 %), or dB when the unit says." .

openrig:inputGain
    a openrig:Role ;
    rdfs:label "inputGain" ;
    rdfs:comment "Gain applied before the effect, dB." .

openrig:outputGain
    a openrig:Role ;
    rdfs:label "outputGain" ;
    rdfs:comment "Gain applied after the effect, dB." .

openrig:inputLevel
    a openrig:Role ;
    rdfs:label "inputLevel" ;
    rdfs:comment "Meter: input level, dBFS." .

openrig:outputLevel
    a openrig:Role ;
    rdfs:label "outputLevel" ;
    rdfs:comment "Meter: output level, dBFS." .

openrig:lfoRate
    a openrig:Role ;
    rdfs:label "lfoRate" ;
    rdfs:comment "LFO frequency, Hz." .

openrig:lfoDepth
    a openrig:Role ;
    rdfs:label "lfoDepth" ;
    rdfs:comment "Modulation depth. The minimum of the range is no modulation, the maximum is full modulation." .

openrig:lfoShape
    a openrig:Role ;
    rdfs:label "lfoShape" ;
    rdfs:comment "Continuous waveform morph of openrig:waveform, from the minimum to the maximum of the range." .

openrig:lfoWaveform
    a openrig:Role ;
    rdfs:label "lfoWaveform" ;
    rdfs:comment "Choice of waveform; scale point labels name the waveforms of openrig:Waveform (Sine, Triangle, Square, Saw Up, Saw Down)." .

openrig:lfoTempoDivision
    a openrig:Role ;
    rdfs:label "lfoTempoDivision" ;
    rdfs:comment "Choice of note value the LFO follows when synced to the tempo; scale point labels are note values (1/4, 1/8., 1/8T). A value of 0 means not synced." .

openrig:lfoPhase
    a openrig:Role ;
    rdfs:label "lfoPhase" ;
    rdfs:comment "Meter: current LFO phase in turns, 0 to 1." .

openrig:stereoPhase
    a openrig:Role ;
    rdfs:label "stereoPhase" ;
    rdfs:comment "Phase offset of the right channel's LFO, degrees, or spread (0 to 100 %)." .

openrig:modulationGain
    a openrig:Role ;
    rdfs:label "modulationGain" ;
    rdfs:comment "Meter: gain the modulation applies now, linear 0 to 1." .

openrig:crossoverFrequency
    a openrig:Role ;
    rdfs:label "crossoverFrequency" ;
    rdfs:comment "Split frequency between bands modulated differently, Hz." .

openrig:threshold
    a openrig:Role ;
    rdfs:label "threshold" ;
    rdfs:comment "Level where the dynamics curve bends, dBFS." .

openrig:ratio
    a openrig:Role ;
    rdfs:label "ratio" ;
    rdfs:comment "Compression ratio (input dB over output dB above the threshold)." .

openrig:knee
    a openrig:Role ;
    rdfs:label "knee" ;
    rdfs:comment "Width of the soft knee, dB." .

openrig:attack
    a openrig:Role ;
    rdfs:label "attack" ;
    rdfs:comment "Attack time, ms." .

openrig:release
    a openrig:Role ;
    rdfs:label "release" ;
    rdfs:comment "Release time, ms." .

openrig:makeup
    a openrig:Role ;
    rdfs:label "makeup" ;
    rdfs:comment "Gain added after the reduction, dB." .

openrig:range
    a openrig:Role ;
    rdfs:label "range" ;
    rdfs:comment "How far a gate or expander lowers the signal, dB (negative)." .

openrig:gainReduction
    a openrig:Role ;
    rdfs:label "gainReduction" ;
    rdfs:comment "Meter: current gain reduction, dB (positive or negative, units say)." .

openrig:delayTime
    a openrig:Role ;
    rdfs:label "delayTime" ;
    rdfs:comment "Time between echoes, in the port's unit (s or ms)." .

openrig:feedback
    a openrig:Role ;
    rdfs:label "feedback" ;
    rdfs:comment "Share of each echo fed into the next, 0 to the maximum of the range (1 or 100 %)." .

openrig:delayTempoDivision
    a openrig:Role ;
    rdfs:label "delayTempoDivision" ;
    rdfs:comment "Choice of note value the delay follows when synced to the tempo; a value of 0 means not synced." .

openrig:currentDelayTime
    a openrig:Role ;
    rdfs:label "currentDelayTime" ;
    rdfs:comment "Meter: delay time playing now, after tempo sync and any glide, in the port's unit (s or ms)." .

openrig:pingPong
    a openrig:Role ;
