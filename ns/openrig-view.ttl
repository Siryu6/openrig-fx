openrig:Compressor
    a openrig:DynamicsKind ;
    rdfs:label "Compressor" ;
    rdfs:comment "Kind of dynamics processor." .

openrig:Limiter
    a openrig:DynamicsKind ;
    rdfs:label "Limiter" ;
    rdfs:comment "Kind of dynamics processor." .

openrig:Gate
    a openrig:DynamicsKind ;
    rdfs:label "Gate" ;
    rdfs:comment "Kind of dynamics processor." .

openrig:Expander
    a openrig:DynamicsKind ;
