    rdfs:comment "Toggle: echoes alternate between the left and right outputs." .

openrig:preDelay
    a openrig:Role ;
    rdfs:label "preDelay" ;
    rdfs:comment "Delay before the reverb, ms." .

openrig:decay
    a openrig:Role ;
    rdfs:label "decay" ;
    rdfs:comment "Decay time (RT60) at middle frequencies, s." .

openrig:decayLow
    a openrig:Role ;
    rdfs:label "decayLow" ;
