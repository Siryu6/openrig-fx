    rdfs:comment "Kind of dynamics processor." .

openrig:ModulationCycle
    a openrig:StreamContent ;
    rdfs:label "ModulationCycle" ;
    rdfs:comment "One cycle of the gain the modulation applies, linear 0 to 1, from LFO phase 0 to 1, one row per channel. openrig:position is the current phase." .

openrig:Spectrum
    a openrig:StreamContent ;
    rdfs:label "Spectrum" ;
    rdfs:comment "Magnitude spectrum in dBFS on openrig:length log-spaced bins from 20 Hz to 20 kHz, one row per channel." .

openrig:LevelHistory
    a openrig:StreamContent ;
    rdfs:label "LevelHistory" ;
    rdfs:comment "Level history in dBFS, oldest value first, evenly spaced over the frame interval, one row per channel." .

openrig:StepGrid
    a openrig:StreamContent ;
    rdfs:label "StepGrid" ;
    rdfs:comment "One bar from the downbeat in openrig:length equal cells, three rows: the level each cell lets through (linear, 0 to 1); its source (0 the live input, 1 the slice being captured, 2 a repeat of it); its playback speed (1 normal, 0 stopped, negative backward). openrig:position is the playhead, the fraction of the bar elapsed." .

openrig:Basic
    a openrig:Family ;
    rdfs:label "Basic" ;
    rdfs:comment "A simple, versatile tool. The host draws it in its own look; openrig:faceColor and openrig:knobStyle are hints at most." .

openrig:Signature
    a openrig:Family ;
    rdfs:label "Signature" ;
    rdfs:comment "A plugin with a character of its own. The host draws it as a faceplate in its openrig:faceColor with openrig:knobStyle knobs." .

openrig:Plain
    a openrig:KnobStyle ;
    rdfs:label "Plain" ;
    rdfs:comment "The host's own knob." .

openrig:Skirted
    a openrig:KnobStyle ;
    rdfs:label "Skirted" ;
    rdfs:comment "A cap over a wider skirt marked with the scale, a line pointer on the cap." .

openrig:Chickenhead
    a openrig:KnobStyle ;
    rdfs:label "Chickenhead" ;
    rdfs:comment "A tapered pointer knob: the position reads from the shape itself." .

openrig:Domed
    a openrig:KnobStyle ;
    rdfs:label "Domed" ;
    rdfs:comment "A smooth round cap with a dot or short line as the pointer." .

openrig:Painted
    a openrig:Finish ;
    rdfs:label "Painted" ;
    rdfs:comment "Paint over the enclosure: an even colour with a slight grain." .

openrig:Brushed
    a openrig:Finish ;
    rdfs:label "Brushed" ;
    rdfs:comment "Bare brushed metal tinted by the colour: fine parallel streaks." .

openrig:Silkscreen
    a openrig:PlateStyle ;
    rdfs:label "Silkscreen" ;
    rdfs:comment "The plate name printed plainly in the host's lettering. The default." .

openrig:Glitch
    a openrig:PlateStyle ;
    rdfs:label "Glitch" ;
    rdfs:comment "The plate name cut by two horizontal bands shifted sideways, as a corrupted picture: the band from 20 to 30 % of the cap height (from the baseline) moves right by 8 % of the cap height and takes the host's accent colour, the band from 62 to 70 % moves left by 4 %. Fixed, never animated." .
